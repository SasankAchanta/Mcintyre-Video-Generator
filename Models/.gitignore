# Deploy only the best trained checkpoint and its PyTorch configuration.
/AIMD Mcyntyre DLC Model/dlc-models-pytorch/**/train/*
!/AIMD Mcyntyre DLC Model/dlc-models-pytorch/**/train/pytorch_config.yaml
!/AIMD Mcyntyre DLC Model/dlc-models-pytorch/**/train/snapshot-best-020.pt
